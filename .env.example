# Preenchido automaticamente pela Vercel quando você conecta um banco Postgres
# (Vercel Storage > Create Database). Não precisa mexer manualmente.
DATABASE_URL=""

# Gere um valor aleatório em https://generate-secret.vercel.app/32
# e cole aqui / na Vercel como variável de ambiente.
NEXTAUTH_SECRET=""

# URL do seu site depois de publicado, ex: https://dna-reprobull.vercel.app
NEXTAUTH_URL=""

# Chave secreta que você escolhe, usada para rodar a configuração inicial
# (criação dos 5 usuários) uma única vez, visitando /api/setup?key=ESSA_CHAVE
SETUP_KEY=""
